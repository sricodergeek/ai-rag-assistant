# Backend only. Replace placeholders locally; never put OpenAI credentials in VITE_*.
OPENAI_API_KEY=replace-with-your-key
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/knowledge_assistant
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=replace-with-your-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
ENVIRONMENT=development
SESSION_COOKIE_SECURE=false

# Per authenticated user; resets at midnight UTC. Zero disables new voice requests.
VOICE_STT_DAILY_LIMIT=10
VOICE_TTS_DAILY_LIMIT=5
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
TTS_FORMAT=mp3
